<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="wallet.controller.ClientsController" styleClass="tab-body">
    <top>
        <VBox spacing="10" styleClass="tab-top">
            <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="8">
                <Button text="+ Новый клиент" onAction="#onAdd" styleClass="button-primary"/>
                <Button fx:id="editButton" text="Изменить" onAction="#onEdit"/>
                <Button fx:id="deleteButton" text="Удалить" onAction="#onDelete" styleClass="button-danger"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Экспорт таблицы…" onAction="#onExport"/>
            </HBox>
            <FlowPane styleClass="filter-bar" hgap="12" vgap="8">
                <TextField fx:id="searchField" promptText="Поиск: ФИО, email, телефон, кошелёк" prefWidth="290"/>
                <ComboBox fx:id="statusFilter" prefWidth="200"/>
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="Регистрация с" styleClass="filter-label"/>
                    <DatePicker fx:id="fromDate" promptText="ДД.ММ.ГГГГ" prefWidth="135"/>
                    <Label text="по" styleClass="filter-label"/>
                    <DatePicker fx:id="toDate" promptText="ДД.ММ.ГГГГ" prefWidth="135"/>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="Сортировка" styleClass="filter-label"/>
                    <ComboBox fx:id="sortChoice" prefWidth="230"/>
                </HBox>
                <Button text="Сбросить" onAction="#onResetFilters" styleClass="button-link"/>
            </FlowPane>
            <Label fx:id="filterError" styleClass="filter-error" wrapText="true" managed="false" visible="false"/>
        </VBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.7" styleClass="content-split">
            <TableView fx:id="table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="nameColumn" text="ФИО" prefWidth="170" minWidth="120"/>
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="180" minWidth="120"/>
                    <TableColumn fx:id="phoneColumn" text="Телефон" prefWidth="125" minWidth="120"/>
                    <TableColumn fx:id="registeredColumn" text="Регистрация" prefWidth="105" minWidth="100"/>
                    <TableColumn fx:id="walletColumn" text="Кошелёк" prefWidth="110" minWidth="105"/>
                    <TableColumn fx:id="balanceColumn" text="Баланс" prefWidth="115" minWidth="105" styleClass="align-right"/>
                    <TableColumn fx:id="statusColumn" text="Статус" prefWidth="130" minWidth="125"/>
                </columns>
                <placeholder>
                    <Label text="Клиенты не найдены. Измените условия поиска или сбросьте фильтры." styleClass="muted"/>
                </placeholder>
            </TableView>
            <ScrollPane fitToWidth="true" minWidth="320" SplitPane.resizableWithParent="false" styleClass="details-scroll">
                <VBox styleClass="details-pane" spacing="12">
                    <Label fx:id="detailsPlaceholder" wrapText="true" styleClass="muted"
                           text="Выберите клиента в таблице, чтобы увидеть его данные, кошелёк и операции. Двойной щелчок по строке открывает редактирование."/>
                    <VBox fx:id="details" spacing="12">
                        <Label fx:id="nameValue" styleClass="details-title" wrapText="true"/>
                        <GridPane hgap="12" vgap="6">
                            <columnConstraints>
                                <ColumnConstraints minWidth="90"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Email" styleClass="details-key" GridPane.rowIndex="0"/>
                            <Label fx:id="emailValue" styleClass="details-value" wrapText="true"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                            <Label text="Телефон" styleClass="details-key" GridPane.rowIndex="1"/>
                            <Label fx:id="phoneValue" styleClass="details-value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                            <Label text="Регистрация" styleClass="details-key" GridPane.rowIndex="2"/>
                            <Label fx:id="registeredValue" styleClass="details-value" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        </GridPane>

                        <VBox fx:id="walletCard" styleClass="wallet-card" spacing="10">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="МИР" styleClass="card-brand"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="cardStatusLabel" styleClass="badge"/>
                            </HBox>
                            <Label fx:id="cardNumberLabel" styleClass="card-number"/>
                            <HBox alignment="CENTER_LEFT">
                                <Label fx:id="cardHolderLabel" styleClass="card-text"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="cardExpiryLabel" styleClass="card-text"/>
                            </HBox>
                            <HBox alignment="BOTTOM_LEFT">
                                <Label fx:id="cardBalanceLabel" styleClass="card-balance"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="cardWalletNumberLabel" styleClass="card-text"/>
                            </HBox>
                        </VBox>
                        <GridPane fx:id="walletInfo" hgap="12" vgap="6">
                            <columnConstraints>
                                <ColumnConstraints minWidth="90"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Лимит на сегодня" styleClass="details-key" GridPane.rowIndex="0"/>
                            <Label fx:id="limitValue" styleClass="details-value" wrapText="true"
                                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        </GridPane>
                        <Label fx:id="noWalletLabel" text="У клиента нет кошелька" styleClass="muted"/>

                        <Label fx:id="operationsTitle" styleClass="section-title"/>
                        <ListView fx:id="operationsList" prefHeight="260" styleClass="operations-list">
                            <placeholder>
                                <Label text="Операций по кошельку пока нет" styleClass="muted"/>
                            </placeholder>
                        </ListView>
                    </VBox>
                </VBox>
            </ScrollPane>
        </SplitPane>
    </center>
    <bottom>
        <Label fx:id="countLabel" styleClass="count-label"/>
    </bottom>
</BorderPane>
