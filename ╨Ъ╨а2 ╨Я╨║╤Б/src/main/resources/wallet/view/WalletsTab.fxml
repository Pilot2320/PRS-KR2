<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="wallet.controller.WalletsController" styleClass="tab-body">
    <top>
        <VBox spacing="10" styleClass="tab-top">
            <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="8">
                <Button fx:id="statusButton" text="Изменить статус" onAction="#onChangeStatus" styleClass="button-primary"/>
                <Button fx:id="operationButton" text="Новая операция" onAction="#onNewOperation"/>
                <Button fx:id="historyButton" text="Операции кошелька →" onAction="#onShowOperations"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Экспорт таблицы…" onAction="#onExport"/>
            </HBox>
            <FlowPane styleClass="filter-bar" hgap="12" vgap="8">
                <TextField fx:id="searchField" promptText="Поиск: номер, владелец, держатель, 4 цифры карты" prefWidth="330"/>
                <ComboBox fx:id="statusFilter" prefWidth="170"/>
                <ComboBox fx:id="validityFilter" prefWidth="200"/>
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="Сортировка" styleClass="filter-label"/>
                    <ComboBox fx:id="sortChoice" prefWidth="260"/>
                </HBox>
                <Button text="Сбросить" onAction="#onResetFilters" styleClass="button-link"/>
            </FlowPane>
        </VBox>
    </top>
    <center>
        <TableView fx:id="table">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="numberColumn" text="Номер" prefWidth="110"/>
                <TableColumn fx:id="ownerColumn" text="Владелец" prefWidth="190"/>
                <TableColumn fx:id="cardColumn" text="Карта «Мир»" prefWidth="110"/>
                <TableColumn fx:id="expiryColumn" text="Действует до" prefWidth="120"/>
                <TableColumn fx:id="balanceColumn" text="Баланс" prefWidth="130" styleClass="align-right"/>
                <TableColumn fx:id="limitColumn" text="Можно перевести сегодня" prefWidth="180" styleClass="align-right"/>
                <TableColumn fx:id="statusColumn" text="Статус" prefWidth="130" minWidth="125"/>
            </columns>
            <placeholder>
                <Label text="Кошельки не найдены. Измените условия поиска или сбросьте фильтры." styleClass="muted"/>
            </placeholder>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label fx:id="countLabel" styleClass="count-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Двойной щелчок по строке — смена статуса" styleClass="count-label"/>
        </HBox>
    </bottom>
</BorderPane>
